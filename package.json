{
  "name": "dsh-claudecode-prompt",
  "version": "0.1.0",
  "description": "Run DeepSeek Harness on Claude Code's system prompt — a bundle that swaps the assembled system prompt for the real Claude Code prompt while tools, runtime context and every other plugin stay exactly as they were.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./lib/transform": "./lib/transform.js",
    "./lib/config": "./lib/config.js",
    "./prompt/claude-code-cli.md": "./prompt/claude-code-cli.md",
    "./prompt/claude-code-vscode.md": "./prompt/claude-code-vscode.md"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menghuanshiguang/dsh-claudecode-prompt.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "claude-code",
    "system-prompt",
    "prompt-engineering"
  ],
  "scripts": {
    "test": "node --test test/",
    "test:transform": "node test/transform.test.mjs",
    "test:assemble": "node test/assemble.test.mjs",
    "capture": "python tools/capture_cc_prompt.py"
  },
  "files": [
    "index.js",
    "lib",
    "prompt",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
